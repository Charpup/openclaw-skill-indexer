{
  "name": "skill-indexer",
  "version": "1.1.0",
  "description": "OpenClaw Skill Registry & Index Manager - Scans, indexes, and manages OpenClaw skills",
  "main": "lib/skill-indexer.js",
  "bin": {
    "skill-indexer": "./bin/skill-indexer.js"
  },
  "scripts": {
    "index": "node bin/skill-indexer.js index",
    "search": "node bin/skill-indexer.js search",
    "list": "node bin/skill-indexer.js list",
